#!/bin/bash
# Bootstrap for the ${project_name} application instance.
# Runs once, at first boot. Application deployments are done afterwards by the
# pipeline through SSM Run Command, not here.
set -euxo pipefail

exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

REGION="${aws_region}"
SSM_PREFIX="${ssm_prefix}"
PROJECT="${project_name}"
DB_NAME="${db_name}"
DB_USERNAME="${db_username}"
ECR_REPO="${ecr_repository_url}"

# ---------------------------------------------------------------------------
# Swap
#
# t3.micro has 1 GiB of RAM and this box runs a JVM next to PostgreSQL. Swap
# turns an out-of-memory kill into a slowdown.
# ---------------------------------------------------------------------------
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
dnf update -y
dnf install -y docker

# Cap container logs. An unbounded json-file log will fill a 20 GiB root
# volume and take the instance down with it.
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'DOCKERCFG'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DOCKERCFG

systemctl enable --now docker
usermod -aG docker ec2-user

# The SSM agent ships with Amazon Linux 2023; make sure it is running, since
# it is the only way in once this finishes.
systemctl enable --now amazon-ssm-agent

# ---------------------------------------------------------------------------
# Shared configuration for the deploy script
# ---------------------------------------------------------------------------
mkdir -p /opt/$${PROJECT}
cat > /opt/$${PROJECT}/config.env <<CONFIGEOF
AWS_REGION=$${REGION}
SSM_PREFIX=$${SSM_PREFIX}
PROJECT=$${PROJECT}
ECR_REPO=$${ECR_REPO}
DB_NAME=$${DB_NAME}
DB_USERNAME=$${DB_USERNAME}
APP_NETWORK=appnet
CONFIGEOF
chmod 600 /opt/$${PROJECT}/config.env

# ---------------------------------------------------------------------------
# Database container
#
# Kept on a private docker network with no published port, so it is reachable
# only from the application container on the same host. With enable_rds = true
# this is replaced by a managed instance in a private subnet.
# ---------------------------------------------------------------------------
docker network inspect appnet >/dev/null 2>&1 || docker network create appnet

DB_PASSWORD=$$(aws ssm get-parameter \
  --name "$${SSM_PREFIX}/db/password" \
  --with-decryption \
  --region "$${REGION}" \
  --query 'Parameter.Value' \
  --output text)

if ! docker ps -a --format '{{.Names}}' | grep -q '^postgres$$'; then
  docker volume create pgdata
  docker run -d \
    --name postgres \
    --network appnet \
    --restart unless-stopped \
    --memory 320m \
    -e POSTGRES_DB="$${DB_NAME}" \
    -e POSTGRES_USER="$${DB_USERNAME}" \
    -e POSTGRES_PASSWORD="$${DB_PASSWORD}" \
    -v pgdata:/var/lib/postgresql/data \
    --health-cmd="pg_isready -U $${DB_USERNAME} -d $${DB_NAME}" \
    --health-interval=10s \
    --health-retries=10 \
    postgres:16-alpine
fi

echo "Bootstrap complete. Waiting for the pipeline to deploy an application image."
