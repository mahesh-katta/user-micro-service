# Copy to .env and fill in real values. .env is gitignored and must stay that way.

# --- Database ---
DB_NAME=userservice_db
DB_USERNAME=postgres
DB_PASSWORD=change-me-locally
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
# Must be at least 32 bytes for HMAC-SHA256, or the app fails fast at startup.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-output
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- App ---
SERVER_PORT=8080
JPA_SHOW_SQL=false
LOG_LEVEL_APP=INFO
